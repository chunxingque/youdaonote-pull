{"2":"1","3":"UtDy-1701141309776","4":{"fv":"0"},"5":[{"3":"76ymli1701141307084","4":{"u":"https://note.youdao.com/yws/res/38353/e2acca6fa529b8b6923e614646f88573"},"6":"im"},{"3":"77jszc1701141307092","5":[{"2":"2","3":"SfPI-1701141309787","7":[{"8":"【耳畔】未选择的路——罗伯特·弗罗斯特","9":[{"2":"b"},{"0":32,"2":"fs"}]}]}]},{"3":"55ebyd1701141307100","5":[{"2":"2","3":"oACB-1701141309789","7":[{"8":"2020-08-28 12:22:11"}]}]},{"3":"88daqq1701141307105","5":[{"2":"2","3":"qZfO-1701141309791","7":[{"8":"《未选择的路》是美国诗人罗伯特·弗罗斯特创作的文学作品。这首深邃的哲理诗展现了现实生活中人们处在十字路口时难以抉择的心情。在诗中，诗人选择了一条人迹稀少、布满荆棘的道路，正如诗人在现实生活中选择了不会带来丰富物质的写诗生活。诗人在作出抉择后，同时又遗憾“鱼和熊掌不可兼得”，只能选择一条路，并坚定地走下去，只有在多年以后的回忆中轻叹遗憾。这首诗朴实无华而清新隽永、寓意深刻，自如的节奏中透着坚定又渗出丝丝遗憾。整首诗韵律优美，读起来传递着优雅的音乐感。"}]}]},{"3":"9ygkx1701141307108","5":[{"2":"2","3":"Rmxw-1701141309793","7":[{"8":"播讲｜周乐"}]}]},{"3":"68qens1701141307109","4":{"u":"https://note.youdao.com/yws/res/38355/3ca5f48b71a537be4bdb07c8fd62dd3e","s":{"t":"center"}},"6":"im"},{"3":"39imyd1701141307110","5":[{"2":"2","3":"F1tg-1701141309795","7":[{"8":"深黄的林子里有两条岔开的路，"}]}]},{"3":"96ljqn1701141307110","5":[{"2":"2","3":"Ho6T-1701141309797","7":[{"8":"很遗憾，我，一个过路人，"}]}]},{"3":"42zikj1701141307111","5":[{"2":"2","3":"8dn8-1701141309799","7":[{"8":"没法同时踏上两条征途，"}]}]},{"3":"37yxyd1701141307111","5":[{"2":"2","3":"YxF5-1701141309800","7":[{"8":"伫立好久，我向一条路远远望去，"}]}]},{"3":"92auye1701141307112","5":[{"2":"2","3":"eql2-1701141309802","7":[{"8":"直到它打弯，视线被灌木丛挡住。"}]}]},{"3":"18qcwz1701141307112","5":[{"2":"2","3":"VZLD-1701141309804","7":[{"8":"于是我选了另一条，不比那条差，"}]}]},{"3":"66tavl1701141307113","5":[{"2":"2","3":"4XuF-1701141309805","7":[{"8":"也许我还能说出更好的理由，"}]}]},{"3":"34rnwr1701141307113","5":[{"2":"2","3":"AxV6-1701141309807","7":[{"8":"因为它绿草茸茸，等待人去践踏——"}]}]},{"3":"7duoh1701141307114","5":[{"2":"2","3":"twzE-1701141309808","7":[{"8":"其实讲到留下了来往的足迹，"}]}]},{"3":"72ahsn1701141307115","5":[{"2":"2","3":"8P5v-1701141309810","7":[{"8":"两条路，说不上差别有多大。"}]}]},{"3":"97qhjj1701141307115","5":[{"2":"2","3":"tHAi-1701141309811","7":[{"8":"那天早晨，有两条路，相差无几，"}]}]},{"3":"25mlos1701141307116","5":[{"2":"2","3":"eTqN-1701141309812","7":[{"8":"都埋在还没被踩过的落叶底下。"}]}]},{"3":"48qcev1701141307117","5":[{"2":"2","3":"ByE3-1701141309814","7":[{"8":"啊，我把那第一条路留给另一天！"}]}]},{"3":"25wztz1701141307118","5":[{"2":"2","3":"fFdx-1701141309815","7":[{"8":"可我知道，一条路又接上另一条，"}]}]},{"3":"22jvkn1701141307118","5":[{"2":"2","3":"kBEz-1701141309817","7":[{"8":"将来能否重回旧地，这就难言。"}]}]},{"3":"39gwdx1701141307119","5":[{"2":"2","3":"Jbaj-1701141309818","7":[{"8":"隔了多少岁月，流逝了多少时光，"}]}]},{"3":"57bxyz1701141307120","5":[{"2":"2","3":"1aZz-1701141309820","7":[{"8":"我将叹一口气，提起当年的旧事："}]}]},{"3":"47qzvk1701141307121","5":[{"2":"2","3":"xHTb-1701141309821","7":[{"8":"林子里有两条路，朝着两个方向，"}]}]},{"3":"54bwxs1701141307122","5":[{"2":"2","3":"X4Il-1701141309822","7":[{"8":"而我——我走上一条更少人迹的路，"}]}]},{"3":"93sdev1701141307123","5":[{"2":"2","3":"Xjs6-1701141309824","7":[{"8":"于是带来完全不同的一番景象。"}]}]},{"3":"87wqcq1701141307124","5":[{"2":"2","3":"NQ2q-1701141309825","7":[{"8":"译｜方平"}]}]},{"3":"4xhcw1701141307125","4":{"u":"https://note.youdao.com/yws/res/38354/da4ff86bbac8d2192f78db8f232ed62b","s":{"t":"center"}},"6":"im"},{"3":"6btnn1701141307126","5":[{"2":"2","3":"6nz4-1701141309827","7":[{"8":"罗伯特·弗罗斯特（Robert Frost，1874—1963），诗人。生于加利福尼亚州旧金山市，父亲为记者，后从政，在儿子11岁时亡故。母亲为中学教师，收入微薄，加之外祖父多病，一家人勉强维持生计。弗罗斯特曾就读于达特茅斯学院和哈佛大学，但均中途辍学，在30岁之前的十余年间始终靠打零工谋生。弗罗斯特自幼喜好文学，自学写诗，20岁时在《纽约独立报》发表第一首诗歌《我的蝴蝶》（My Butterfly）。20世纪初叶，赴欧洲进行创作和发展是当时美国作家的时尚，弗罗斯特为之所动，1912年举家迁居英国，开始了诗歌创作的一个辉煌时期。"}]}]}],"__compress__":true,"title":""}